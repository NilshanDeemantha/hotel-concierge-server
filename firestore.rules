rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Who may read what, from a browser:
    // - A signed-in guest may read only their own conversation and messages, so the chat updates live.
    // - A signed-in admin (an account with the `admin` claim set to true) may also read every conversation,
    //   every message, every guest profile in `users`, every room and all availability, for the staff dashboard.
    // - Nobody else may read anything. Guests cannot read `users`, `rooms` or `availability`.
    // Nobody writes from a browser, admins included: only this server writes, through the Admin SDK, which ignores these rules.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /conversations/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
    match /messages/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
    match /users/{id} {
      allow read: if isAdmin();
    }
    match /rooms/{id} {
      allow read: if isAdmin();
    }
    match /availability/{id} {
      allow read: if isAdmin();
    }
    match /{document=**} {
      allow write: if false;
    }
  }
}
